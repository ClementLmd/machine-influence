{
  "name": "machine-influence",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter front dev\" \"pnpm --filter back dev\"",
    "build": "pnpm -r run build",
    "start": "concurrently \"pnpm --filter front start\" \"pnpm --filter back start:prod\"",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
