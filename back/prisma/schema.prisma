generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid())
  supabaseId        String   @unique
  email             String   @unique
  role              UserRole
  firstName         String?
  lastName          String?
  profilePicture    String?
  description       String?
  skills            String[]
  rate              Float?
  isProfileComplete Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum UserRole {
  RECRUITER
  INDEPENDENT
}
